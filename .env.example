# Fill these from the Infra Onboarding Guide once your team VM is launched
# (community.vastdata.com/c/workshop -> Access the Builders Challenge).

# VAST Data S3 (video/segment buckets)
VAST_S3_ENDPOINT=
VAST_S3_ACCESS_KEY=
VAST_S3_SECRET_KEY=

# VSS video-summarization API on the team VM (tunnel: ssh -N -L 38111:localhost:38111 team-vm)
VSS_BASE_URL=http://localhost:38111
VSS_API_KEY=

# Cosmos VLM, if exposed directly as an OpenAI-compatible endpoint
COSMOS_BASE_URL=
COSMOS_API_KEY=

# Weights & Biases Inference — https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_BASE_URL=https://api.inference.wandb.ai/v1

# New live simulation: inference is intentionally off for local physics previews.
# Enable only after configuring GPU_BEARER_TOKEN through TEAM_CONFIG outside this repo.
SCENE2REAL_LIVE_COSMOS=0

# Mobile instruction planning only. Grounding/matching still require OPENAI_API_KEY.
# astra (default), wandb (explicit candidate), shadow (Astra active; W&B non-executable).
SCENE2REAL_PLANNER_PROVIDER=astra
SCENE2REAL_WANDB_PLANNER_MODEL=openai/gpt-oss-20b
SCENE2REAL_WANDB_OUTPUT_FORMAT=json_schema
SCENE2REAL_WANDB_MAX_TOKENS=8192
SCENE2REAL_PLANNER_MAX_ATTEMPTS=2
SCENE2REAL_WANDB_TIMEOUT_S=45
# W&B hosted inference project header and Weave destination.
WANDB_TEAM=vastdata
WANDB_PROJECT=team-28
# Set 0 for credential-free local telemetry; inference selection is independent.
SCENE2REAL_WEAVE=1
# auto uses Astra spatial review when configured; 0 explicitly uses Cosmos-only evidence.
SCENE2REAL_SPATIAL_REVIEW=auto
OPENAI_API_KEY=
# Actual Cosmos endpoint settings (five timestamped images per view).
COSMOS_URL=http://166.19.38.112:8001
GPU_BEARER_TOKEN=
# Native VAST archival variables from /config/team-28.config; never commit values.
S3_ENDPOINT=
ACCESS_KEY=
SECRET_KEY=
S3_CHUNKS_BUCKET=
S3_SEGMENTS_BUCKET=
